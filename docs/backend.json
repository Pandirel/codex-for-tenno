
{
  "entities": {
    "giveaway": {
      "title": "Giveaway",
      "description": "Represents a single giveaway event.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "prizeImage": {
          "type": "string",
          "format": "uri"
        },
        "drawDate": {
          "type": "string",
          "format": "date-time"
        },
        "active": {
          "type": "boolean",
          "description": "Indicates if the giveaway is currently active."
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "description": "Discord User ID" },
              "username": { "type": "string", "description": "Discord Username" }
            },
            "required": ["id", "username"]
          }
        },
        "winner": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "username": { "type": "string" }
          }
        }
      },
      "required": ["title", "active", "participants"]
    }
  },
  "auth": {
    "providers": []
  },
  "firestore": {
    "/giveaways/{giveawayId}": {
      "schema": {
        "$ref": "#/entities/giveaway"
      },
      "description": "Stores active and past giveaway events."
    }
  }
}
